DEEPSEEK_API_KEY=
KAGGLE_USERNAME=
KAGGLE_KEY=
GITHUB_TOKEN=
HF_TOKEN=
PG_DSN=postgresql://researcher:researcher@127.0.0.1:5433/kaggle_research

# Persistent source registry and content-addressed processing cache
SOURCE_REGISTRY_ENABLED=true
SOURCE_REFRESH_MODE=auto
SOURCE_SEARCH_TTL_KAGGLE_HOURS=24
SOURCE_SEARCH_TTL_GITHUB_HOURS=24
SOURCE_SEARCH_TTL_ARXIV_HOURS=168
SOURCE_SEARCH_TTL_PAPERS_WITH_CODE_HOURS=168
SOURCE_CACHE_ALLOW_STALE_OFFLINE=true
SOURCE_CONTENT_DIR=./data/source_content
SOURCE_ARTIFACT_DIR=./data/source_artifacts

# Kaggle EDA Engine
EDA_RUNS_DIR=./data/eda_runs
KAGGLE_DATASETS_DIR=./data/kaggle_datasets
EDA_SCHEMA_VERSION=1.0
EDA_PROFILE_SAMPLE_ROWS=200000
EDA_MAX_PROFILE_ROWS_FULL_SCAN=2000000
EDA_MAX_ADVERSARIAL_ROWS=500000
EDA_MAX_BASELINE_ROWS=1000000
EDA_RANDOM_SEED=42

# Final Strategy compaction budget
FINAL_STRATEGY_MAX_CORE_EXPERIMENTS=8
FINAL_STRATEGY_MAX_FIRST_24H_EXPERIMENTS=4
FINAL_STRATEGY_MAX_FIRST_48H_EXPERIMENTS=8
FINAL_STRATEGY_MAX_HIGH_COST_EXPERIMENTS=2

# Final Synthesizer two-call protocol
FINAL_SYNTHESIS_PROTOCOL=two_call
FINAL_SYNTHESIS_SELECTION_MODEL=deepseek-v4-pro
FINAL_SYNTHESIS_RENDERING_MODEL=deepseek-v4-pro
FINAL_SYNTHESIS_SELECTION_REPAIR_ATTEMPTS=1
FINAL_SYNTHESIS_RENDERING_REPAIR_ATTEMPTS=1
FINAL_SYNTHESIS_MAX_ACTIONS=15
FINAL_SYNTHESIS_MAX_CORE_EXPERIMENTS=8
FINAL_SYNTHESIS_MAX_BACKLOG_EXPERIMENTS=12
FINAL_SYNTHESIS_MAX_FIRST_24H_EXPERIMENTS=4
FINAL_SYNTHESIS_MAX_FIRST_48H_EXPERIMENTS=8
FINAL_SYNTHESIS_CONTEXT_MAX_CHARS=60000
FINAL_SYNTHESIS_RENDERING_MAX_CHARS=50000
FINAL_SYNTHESIS_ALLOW_DETERMINISTIC_RENDER=true
